# ============================================================
# Bookshelf Web — variables de entorno
# Copia este archivo a `.env.local` y rellena con valores reales.
# NUNCA subir `.env.local` al repositorio (ver .gitignore raíz).
#
# Obtención: Supabase Dashboard → Settings → API
#   - Project URL: https://<PROJECT_REF>.supabase.co
#   - anon public: clave PÚBLICA (segura para el frontend)
# ============================================================

# --- Supabase (necesario para crear los clients browser/server) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Site URL (redirects de OAuth / callback) ---
# URL pública de la app (local: http://localhost:3000, prod: https://<dominio>).
# Se usa como base para los redirects de Google OAuth y el callback /auth/callback.
NEXT_PUBLIC_SITE_URL=

# --- Backend (FastAPI) ---
# URL base del backend. En dev se usa http://localhost:8000 por defecto.
# Se usa en los rewrites de next.config.mjs y en los Server Components que
# consultan la API (p. ej. la ficha de libro).
API_URL=