# ============================================================
# Bookshelf API — variables de entorno (backend)
# Copia este archivo a `.env` y rellena con valores reales.
# NUNCA subir `.env` al repositorio (ver .gitignore raíz).
#
# Documento completo: spec/features/021-server-config/spec.md
# Modelo tipado: apps/api/app/core/config.py (Pydantic v2, BaseSettings).
#
# En PRODUCCIÓN las credenciales críticas son obligatorias y la app falla al
# arranque si faltan (fail-fast). Los logs NUNCA incluyen secretos.

# ---------------------------------------------------------------------------
# 1. Entorno
# ---------------------------------------------------------------------------
APP_ENV=development          # development | test | production
DEBUG=false
APP_VERSION=0.1.0
API_HOST=0.0.0.0
API_PORT=8000

# ---------------------------------------------------------------------------
# 2. Base de datos y Supabase
# ---------------------------------------------------------------------------
# URL del proyecto (Dashboard → Settings → API → Project URL).
SUPABASE_URL=https://<project-ref>.supabase.co
# Service role key (SOLO backend, NUNCA en frontend). Dashboard → Settings → API.
SUPABASE_SERVICE_ROLE_KEY=<service_role_key>
# JWT Secret (Dashboard → Settings → Auth → JWT Secret) para verificar HS256.
SUPABASE_JWT_SECRET=<jwt_secret>
# JWKS URL para verificar tokens ES256. Se deriva de SUPABASE_URL si se omite.
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_DB_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------------------
# 3. Inteligencia artificial (Gemini)
# ---------------------------------------------------------------------------
# Requerida para IA (vectorización + chat). Sin clave esas features no funcionan.
GEMINI_API_KEY=<gemini_api_key>
# Modelo de chat configurable (default: gemini-3.5-flash).
GEMINI_CHAT_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_SECONDS=60
CHAT_STREAM_TIMEOUT_SECONDS=60
# EMBEDDING_MODEL / EMBEDDING_DIMENSIONS no son configurables (text-embedding-004 / 768).

# ---------------------------------------------------------------------------
# 4. Frontend y CORS
# ---------------------------------------------------------------------------
# Orígenes CORS separados por comas; en producción solo dominios oficiales.
CORS_ORIGINS=http://localhost:3000
# URL canónica del sitio en producción (define la allowlist CORS oficial).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# 5. Servicios externos (ISBN lookup)
# ---------------------------------------------------------------------------
# Google Books API key (opcional, fallback): sin key = 1000 req/día.
GOOGLE_BOOKS_API_KEY=
OPEN_LIBRARY_TIMEOUT_SECONDS=10
ISBN_CACHE_TTL_SECONDS=3600
ISBN_RATE_LIMIT_PER_MINUTE=100

# ---------------------------------------------------------------------------
# 6. Logs y monitorización
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json              # console | json
SENTRY_DSN=                  # opcional
ENABLE_REQUEST_LOGGING=false
ENABLE_METRICS=false

# ---------------------------------------------------------------------------
# 7. Seguridad
# ---------------------------------------------------------------------------
AUTH_REQUIRED=false
ACCESS_TOKEN_EXPIRE_MINUTES=60
MAX_REQUEST_BODY_SIZE_MB=10
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS_PER_MINUTE=60
TRUSTED_PROXY_IPS=
