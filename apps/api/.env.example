# ============================================================
# Bookshelf API — variables de entorno
# Copia este archivo a `.env` y rellena con valores reales.
# NUNCA subir `.env` al repositorio (ver .gitignore raíz).
# ============================================================

# --- Supabase ---
# URL del proyecto (Dashboard → Settings → API → Project URL)
SUPABASE_URL=https://<project-ref>.supabase.co
# Service role key (SOLO backend, NUNCA en frontend). Dashboard → Settings → API.
SUPABASE_SERVICE_ROLE_KEY=<service_role_key>
# JWT Secret (Dashboard → Settings → Auth → JWT Secret). Necesario para verificar tokens HS256.
SUPABASE_JWT_SECRET=<jwt_secret>
# JWKS URL para verificar tokens ES256 (si el proyecto usa claves asimétricas).
# Si se omite, se usa {SUPABASE_URL}/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=

# --- Google Gemini ---
# Requerida para IA: vectorización de notas (feature 016, embeddings
# `text-embedding-004` 768 dims) y chat SSE (feature 017, `gemini-2.0-flash`).
# Sin clave, la API arranca pero esas features no funcionan (log de error /
# evento SSE error). NUNCA exponer la clave en respuestas ni logs.
GEMINI_API_KEY=<gemini_api_key>

# --- Google Books (fallback ISBN lookup, feature 008) ---
# Opcional: sin key = 1000 req/día; con key = 10000 req/día.
GOOGLE_BOOKS_API_KEY=

# --- Logging ---
# INFO → JSON estructurado en stdout (producción)
# DEBUG → pretty console (desarrollo)
LOG_LEVEL=INFO
