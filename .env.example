# ============================================================
# Bookshelf — Variables de entorno (plantilla)
# ============================================================
# Copia este archivo a `.env.local` y rellena los valores reales.
# NUNCA subas `.env.local` ni ningún secreto al repositorio.
#
# Obtención de credenciales: Supabase Dashboard → Settings → API
#   - Project URL:   https://<PROJECT_REF>.supabase.co
#   - anon public:   clave PÚBLICA (segura para el frontend)
#   - service_role:  clave PRIVADA (SOLO backend/MCP, nunca en frontend)
#   - JWT Secret:    Settings → Auth → JWT Secret (verificación local)

# --- Supabase (proyecto remoto) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# --- Google OAuth (Auth Supabase + uso directo) ---
# Client ID / Secret: Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Backend (FastAPI) — se añadirán en features posteriores ---
# GEMINI_API_KEY=
# OPEN_LIBRARY_RATE_LIMIT=
# GOOGLE_BOOKS_API_KEY=   # Opcional (feature 008): sin key = 1000 req/día; con key = 10000 req/día