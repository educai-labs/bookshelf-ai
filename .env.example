# ============================================================
# Bookshelf — Variables de entorno (plantilla)
# ============================================================
# Copia este archivo a `.env.local` (frontend) y/o a `apps/api/.env` (backend)
# y rellena los valores reales. NUNCA subas `.env*` ni secretos al repositorio.
#
# Documento completo: spec/features/021-server-config/spec.md
# Modelo tipado: apps/api/app/core/config.py (Pydantic v2, BaseSettings).
# Los nombres son UPPER_SNAKE_CASE y se mapean case-insensitive a los campos
# snake_case del backend.
#
# En PRODUCCIÓN las credenciales críticas son obligatorias y la app falla al
# arranque si faltan (fail-fast). Los logs NUNCA incluyen secretos.

# ---------------------------------------------------------------------------
# 1. Entorno
# ---------------------------------------------------------------------------
# Entorno de ejecución: development | test | production.
APP_ENV=development
# Flag de debug (no activar en producción).
DEBUG=false
# Versión de la aplicación (se refleja en /openapi.json).
APP_VERSION=0.1.0
# Bind del servidor Uvicorn (FastAPI).
API_HOST=0.0.0.0
API_PORT=8000

# ---------------------------------------------------------------------------
# 2. Base de datos y Supabase
# ---------------------------------------------------------------------------
# URL del proyecto (Supabase Dashboard → Settings → API → Project URL).
SUPABASE_URL=https://<project-ref>.supabase.co
# Service role key: SOLO backend/MCP (bypass RLS en operaciones de sistema).
# NUNCA en el frontend ni en variables NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=<service_role_key>
# JWT Secret (Dashboard → Settings → Auth → JWT Secret) para verificar HS256.
SUPABASE_JWT_SECRET=<jwt_secret>
# JWKS URL para verificar tokens ES256. Se deriva de SUPABASE_URL si se omite;
# en producción se exige explícita.
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
# Timeout (segundos) de las consultas a la base de datos.
SUPABASE_DB_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------------------
# 3. Inteligencia artificial (Gemini)
# ---------------------------------------------------------------------------
# Requerida para IA (vectorización de notas + chat SSE). Sin clave, la API
# arranca pero esas features no funcionan (503 / evento SSE error).
GEMINI_API_KEY=<gemini_api_key>
# Modelo de chat configurable (default: gemini-3.5-flash).
GEMINI_CHAT_MODEL=gemini-3.5-flash
# Timeout (segundos) de las llamadas a Gemini.
GEMINI_TIMEOUT_SECONDS=60
# Timeout (segundos) total del stream SSE de chat.
CHAT_STREAM_TIMEOUT_SECONDS=60
# NOTA: EMBEDDING_MODEL y EMBEDDING_DIMENSIONS NO son configurables; están
# fijados a `text-embedding-004` / 768 (límite duro: cambiarlos exige
# re-vectorización completa de las notas).

# ---------------------------------------------------------------------------
# 4. Frontend y CORS
# ---------------------------------------------------------------------------
# Orígenes CORS separados por comas. En producción solo dominios oficiales
# (nunca `*`); en desarrollo suele ser http://localhost:3000.
CORS_ORIGINS=http://localhost:3000
# URL canónica del sitio en producción; también define la allowlist CORS oficial.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# URL base del backend (rewrites de Next.js / Server Components).
API_URL=http://localhost:8000
# URL pública de Supabase (segura para el navegador).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Clave anon pública de Supabase (segura para el navegador).
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon_public_key>

# ---------------------------------------------------------------------------
# 5. Servicios externos (ISBN lookup)
# ---------------------------------------------------------------------------
# Google Books API key (opcional, fallback): sin key = 1000 req/día; con key
# = 10000 req/día. Open Library es la fuente primaria (no requiere key).
GOOGLE_BOOKS_API_KEY=
# Timeout (segundos) de las peticiones a Open Library.
OPEN_LIBRARY_TIMEOUT_SECONDS=10
# TTL (segundos) de la caché de ISBN en memoria (default 1 hora).
ISBN_CACHE_TTL_SECONDS=3600
# Límite de peticiones por minuto a Open Library (sin key = 100 req/min).
ISBN_RATE_LIMIT_PER_MINUTE=100

# ---------------------------------------------------------------------------
# 6. Logs y monitorización
# ---------------------------------------------------------------------------
# Nivel de log: DEBUG | INFO | WARNING | ERROR.
LOG_LEVEL=INFO
# Formato de log: console | json (producción suele usar json).
LOG_FORMAT=json
# DSN de Sentry (opcional).
SENTRY_DSN=
# Registra cada petición HTTP entrante (opcional).
ENABLE_REQUEST_LOGGING=false
# Expone métricas de la aplicación (opcional).
ENABLE_METRICS=false
# Los logs NUNCA incluyen API keys, JWTs, cookies, service role keys, contenido
# completo de notas ni prompts privados (redacción automática antes del render).

# ---------------------------------------------------------------------------
# 7. Seguridad
# ---------------------------------------------------------------------------
# Exige autenticación global (flag; los endpoints ya usan Depends(get_current_user)).
AUTH_REQUIRED=false
# Minutos de expiración del access token.
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Tamaño máximo del body de una petición (MB).
MAX_REQUEST_BODY_SIZE_MB=10
# Habilita el rate limiting global (flag).
RATE_LIMIT_ENABLED=false
# Peticiones por minuto permitidas cuando RATE_LIMIT_ENABLED=true.
RATE_LIMIT_REQUESTS_PER_MINUTE=60
# IPs de proxy confiables (separadas por comas) para X-Forwarded-For.
TRUSTED_PROXY_IPS=

# ---------------------------------------------------------------------------
# Autenticación (Supabase Auth — configuración de proveedores)
# ---------------------------------------------------------------------------
# Google OAuth Client ID / Secret: se configuran en el DASHBOARD de Supabase
# (Authentication → Providers → Google), no en el código. Se documentan aquí
# por trazabilidad; Google Cloud Console → APIs & Services → Credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
